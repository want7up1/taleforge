{
  "name": "taleforge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev:bff": "pnpm --filter @taleforge/bff dev",
    "dev:web": "pnpm --filter @taleforge/web dev",
    "dev": "concurrently -n bff,web -c green,yellow \"pnpm run dev:bff\" \"pnpm run dev:web\"",
    "build": "pnpm --filter @taleforge/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --test apps/web/src/*.test.ts apps/bff/src/*.test.ts packages/*/src/*.test.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
